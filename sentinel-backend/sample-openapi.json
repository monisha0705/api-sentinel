
{
  "openapi": "3.0.3",
  "info": {
    "title": "Sentinel Bank API",
    "version": "1.0.0",
    "description": "Benchmark API for authorization and business logic security testing"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "summary": "Get my accounts",
        "operationId": "getMyAccounts",
        "tags": ["Accounts"]
      }
    },
    "/api/accounts/{id}": {
      "get": {
        "summary": "Get account by ID",
        "operationId": "getAccountById",
        "tags": ["Accounts"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/api/payments": {
      "post": {
        "summary": "Create payment",
        "operationId": "createPayment",
        "tags": ["Payments"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/payments/{id}": {
      "get": {
        "summary": "Get payment by ID",
        "operationId": "getPaymentById",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/payments/{id}/approve": {
      "post": {
        "summary": "Approve payment",
        "operationId": "approvePayment",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/payments/{id}/cancel": {
      "post": {
        "summary": "Cancel payment",
        "operationId": "cancelPayment",
        "tags": ["Payments"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    }
  }
}
